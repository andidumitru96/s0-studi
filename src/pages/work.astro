---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";
---

<BaseLayout title="Interior Design & Architecture Projects | Sector 0" description="Explore residential architecture, apartment interiors, custom furniture and renovation projects by Sector 0 Studio in Bucharest.">
  <main class="page-shell">
    <header class="page-hero page-hero--work section-pad">
      <p class="eyebrow">Archive / 2025—2026</p>
      <h1>Selected<br /><em>work.</em></h1>
      <p>Residential interiors developed through plan, proportion, material and a precise control of atmosphere.</p>
    </header>
    <section class="work-index section-pad" aria-label="Project index">
      {projects.map((project, index) => <div class="reveal"><ProjectCard project={project} index={index} /></div>)}
    </section>
  </main>
</BaseLayout>
