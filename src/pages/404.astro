---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout lang="ro" title="Pagină negăsită | Sector 0 Studio" description="Această pagină nu există. Descoperă proiectele și serviciile de arhitectură și design interior Sector 0 Studio." noindex>
  <main class="page-shell">
    <section class="not-found section-pad">
      <p class="eyebrow">404 / Sector 0 Studio</p>
      <h1>Pagina nu a fost găsită.</h1>
      <p>Poți continua cu portofoliul sau cu serviciile studioului.</p>
      <nav aria-label="Continuă navigarea"><a href="/work/">Vezi proiectele</a><a href="/ro/servicii/">Arhitectură și design interior</a><a href="/contact/">Contact</a></nav>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: 65vh; padding-top: 6rem; padding-bottom: 6rem; }
  h1 { font-size: clamp(2.5rem,7vw,6rem); font-weight: 450; line-height: 1.1; letter-spacing: -0.05em; max-width: 15ch; }
  nav { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2rem; }
  nav a { text-decoration: underline; text-underline-offset: 0.4em; }
</style>
