---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";

const featured = projects.slice(0, 3);
---

<BaseLayout preloadImage={featured[0].cover}>
  <main>
    <section class="hero" aria-label="Featured projects" data-hero data-featured={JSON.stringify(featured.map(({ slug, title, year, discipline }) => ({ slug, title, year, discipline })))}>
      <div class="hero__media" aria-hidden="true">
        {featured.map((project, index) => (
          <img src={project.cover} alt="" class:list={[index === 0 && "is-active"]} fetchpriority={index === 0 ? "high" : "auto"} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
        ))}
      </div>
      <div class="hero__veil"></div>
      <div class="hero__location">Bucharest · Romania · Europe</div>
      <div class="hero__edition">Independent studio / Est. 2024</div>
      <div class="hero__identity"><p>Sector</p><p>Zero</p></div>
      <div class="hero__project" aria-live="polite">
        <p class="hero__project-meta" data-hero-meta>{featured[0].discipline} · {featured[0].year}</p>
        <a href={`/projects/${featured[0].slug}`} data-hero-link><span data-hero-title>{featured[0].title}</span><Icon name="arrow-down-right" /></a>
      </div>
      <div class="hero__controls">
        <div class="hero__indexes" aria-label="Select featured project">
          {featured.map((project, index) => (
            <button type="button" class:list={[index === 0 && "is-active"]} data-hero-index={index} aria-label={`Show ${project.title}`} aria-current={index === 0 ? "true" : undefined}>0{index + 1}</button>
          ))}
        </div>
        <button type="button" class="hero__pause" data-hero-pause aria-label="Pause slideshow">
          <span data-pause-icon><Icon name="pause" /></span><span data-play-icon hidden><Icon name="play" /></span>
        </button>
      </div>
    </section>

    <section class="manifesto section-pad">
      <div class="reveal manifesto__label"><p class="eyebrow">The point of origin</p></div>
      <div class="reveal manifesto__statement"><h1>Every project begins at <em>zero.</em> Plan, proportion, material and light are resolved as one continuous idea.</h1></div>
      <div class="reveal manifesto__note" style="transition-delay:100ms">
        <p>Sector 0 is an independent architecture and interior design studio based in Bucharest, working across residential, commercial and research-led projects.</p>
        <a href="/studio" class="text-link">Discover the studio <Icon name="arrow-right" /></a>
      </div>
    </section>

    <section class="home-services section-pad" aria-labelledby="home-services-title">
      <div class="reveal home-services__heading">
        <p class="eyebrow">Architecture / Interiors / Custom furniture</p>
        <h2 id="home-services-title">Spaces designed from the plan to the last custom detail.</h2>
      </div>
      <div class="home-services__grid">
        <article class="reveal">
          <span>01</span>
          <h3>Architecture</h3>
          <p>Residential architecture and renovation shaped by context, proportion, regulations and construction logic.</p>
        </article>
        <article class="reveal" style="transition-delay:70ms">
          <span>02</span>
          <h3>Interior design</h3>
          <p>Complete interior architecture for apartments and houses, from layouts and materials to lighting and technical drawings.</p>
        </article>
        <article class="reveal" style="transition-delay:140ms">
          <span>03</span>
          <h3>Custom furniture</h3>
          <p>Bespoke furniture and joinery developed as part of the architecture, detailed for trusted makers and precise execution.</p>
        </article>
      </div>
      <div class="reveal home-services__footer">
        <p>Sector 0 is based in Bucharest and works on selected projects across Romania and Europe.</p>
        <a href="/services" class="text-link">Explore our services <Icon name="arrow-right" /></a>
      </div>
    </section>

    <section class="selected-work section-pad">
      <div class="section-heading">
        <p class="eyebrow">Selected work · 2025—2026</p>
        <a href="/work" class="text-link">View all projects <Icon name="arrow-right" /></a>
      </div>
      <div class="selected-work__grid">
        {projects.slice(0, 4).map((project, index) => (
          <div class:list={["reveal", index % 2 && "selected-work__offset"]} style={`transition-delay:${(index % 2) * 90}ms`}>
            <ProjectCard project={project} index={index} />
          </div>
        ))}
      </div>
    </section>

    <section class="approach section-pad">
      <div class="reveal approach__intro"><p class="eyebrow">A controlled process</p><h2>One clear line from first conversation to finished space.</h2></div>
      <div class="approach__steps">
        {[
          ["01", "Define", "Context, ambition, constraints and the exact brief."],
          ["02", "Resolve", "Plan, proportion and atmosphere developed as one system."],
          ["03", "Detail", "Materials, lighting, joinery and technical coordination."],
          ["04", "Deliver", "Documentation, procurement guidance and site continuity."],
        ].map(([number, title, copy], index) => (
          <div class="reveal approach__step" style={`transition-delay:${index * 70}ms`}><span>{number}</span><h3>{title}</h3><p>{copy}</p></div>
        ))}
      </div>
    </section>

    <section class="founder-preview section-pad">
      <div class="reveal founder-preview__image"><img src="/images/Andi Dumitru2.webp" alt="Andi Dumitru, founder and architect at Sector 0 Studio" loading="lazy" /></div>
      <div class="reveal founder-preview__copy" style="transition-delay:100ms">
        <p class="eyebrow">Andi Dumitru / Architect</p>
        <h2>A small practice, closely involved in every project.</h2>
        <p>Sector 0 is currently led by Andi Dumitru as an independent practice. Specialist collaborators are brought in when the scale or technical needs of a project require them, while design and communication remain direct.</p>
        <a href="/studio" class="text-link">Meet Andi Dumitru <Icon name="arrow-right" /></a>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const hero = document.querySelector("[data-hero]");
    if (!hero) return;
    const featured = JSON.parse(hero.dataset.featured || "[]");
    const images = [...hero.querySelectorAll(".hero__media img")];
    const buttons = [...hero.querySelectorAll("[data-hero-index]")];
    const meta = hero.querySelector("[data-hero-meta]");
    const title = hero.querySelector("[data-hero-title]");
    const link = hero.querySelector("[data-hero-link]");
    const pauseButton = hero.querySelector("[data-hero-pause]");
    const pauseIcon = hero.querySelector("[data-pause-icon]");
    const playIcon = hero.querySelector("[data-play-icon]");
    let active = 0;
    let paused = false;
    let timer;

    const show = (index) => {
      active = index;
      images.forEach((image, itemIndex) => image.classList.toggle("is-active", itemIndex === index));
      buttons.forEach((button, itemIndex) => {
        button.classList.toggle("is-active", itemIndex === index);
        if (itemIndex === index) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
      const project = featured[index];
      meta.textContent = `${project.discipline} · ${project.year}`;
      title.textContent = project.title;
      link.href = `/projects/${project.slug}`;
    };

    const start = () => {
      window.clearInterval(timer);
      if (paused || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => show((active + 1) % featured.length), 6500);
    };

    buttons.forEach((button, index) => button.addEventListener("click", () => { show(index); start(); }));
    pauseButton.addEventListener("click", () => {
      paused = !paused;
      pauseButton.setAttribute("aria-label", paused ? "Play slideshow" : "Pause slideshow");
      pauseIcon.hidden = paused;
      playIcon.hidden = !paused;
      start();
    });
    start();
  })();
</script>
