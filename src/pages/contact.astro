---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Contact — Sector 0 Studio" description="Start an architecture or interior design project with Sector 0 Studio.">
  <main class="page-shell contact-page">
    <header class="contact-hero section-pad">
      <p class="eyebrow">New commissions</p>
      <h1>Tell us what you want to <em>make possible.</em></h1>
      <div class="contact-hero__details">
        <p>We review each enquiry personally and usually respond within two working days.</p>
        <div class="contact-links">
          <a href="mailto:info@sector0studio.com">info@sector0studio.com</a>
          <a href="tel:+40770644501">+40 770 644 501</a>
          <a href="https://www.instagram.com/sector0studio/" target="_blank" rel="noreferrer">Instagram</a>
          <a href="https://wa.me/40770644501" target="_blank" rel="noreferrer">WhatsApp</a>
        </div>
      </div>
    </header>

    <form class="project-brief section-pad" data-project-brief>
      <div class="project-brief__heading"><p class="eyebrow">Project brief / 01</p><h2>Start with the essentials.</h2></div>
      <fieldset class="project-brief__choice" data-choice="projectType">
        <legend>What are you planning?</legend>
        <div>
          {['Interior', 'Architecture', 'Renovation', 'Other'].map((type, index) => <button type="button" class:list={[index === 0 && 'is-selected']} aria-pressed={index === 0 ? 'true' : 'false'} data-value={type}>{type}</button>)}
        </div>
      </fieldset>
      <div class="project-brief__fields">
        <div class="field"><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required placeholder="Your name" /></div>
        <div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@email.com" /></div>
        <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+40" /></div>
        <div class="field"><label for="location">Project location</label><input id="location" name="location" placeholder="City / country" /></div>
      </div>
      <fieldset class="project-brief__choice" data-choice="budget">
        <legend>Indicative construction / fit-out investment</legend>
        <div>
          {['€25–50k', '€50–100k', '€100–250k', '€250k+'].map((range, index) => <button type="button" class:list={[index === 1 && 'is-selected']} aria-pressed={index === 1 ? 'true' : 'false'} data-value={range}>{range}</button>)}
        </div>
      </fieldset>
      <div class="field project-brief__message"><label for="message">A few words about the project *</label><textarea id="message" name="message" required rows="6" placeholder="What are you hoping to create, and when would you like to begin?"></textarea></div>
      <button type="submit" class="brief-submit">Prepare enquiry <Icon name="arrow-right" /></button>
      <p class="project-brief__privacy">Your details are used only to respond to this project enquiry.</p>
    </form>

    <section class="brief-success section-pad" data-brief-success hidden aria-live="polite">
      <span><Icon name="check" /></span>
      <p class="eyebrow">Your email is ready</p>
      <h2>Thank you. Your mail app should now be open.</h2>
      <p>Review the message and send it when ready. If it did not open, write directly to <a href="mailto:info@sector0studio.com">info@sector0studio.com</a>.</p>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-project-brief]");
    const success = document.querySelector("[data-brief-success]");
    if (!form || !success) return;
    const selected = { projectType: "Interior", budget: "€50–100k" };
    form.querySelectorAll("[data-choice]").forEach((group) => {
      const name = group.dataset.choice;
      group.querySelectorAll("button").forEach((button) => button.addEventListener("click", () => {
        selected[name] = button.dataset.value;
        group.querySelectorAll("button").forEach((item) => {
          const active = item === button;
          item.classList.toggle("is-selected", active);
          item.setAttribute("aria-pressed", String(active));
        });
      }));
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const body = [
        `Name: ${data.get("name")}`,
        `Email: ${data.get("email")}`,
        `Phone: ${data.get("phone") || "—"}`,
        `Project type: ${selected.projectType}`,
        `Indicative investment: ${selected.budget}`,
        `Location: ${data.get("location") || "—"}`,
        "",
        String(data.get("message")),
      ].join("\n");
      window.location.href = `mailto:info@sector0studio.com?subject=${encodeURIComponent("New project enquiry")}&body=${encodeURIComponent(body)}`;
      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();
</script>
