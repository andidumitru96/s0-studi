---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "Architecture & Interior Design Studio Bucharest | Sector 0",
  description = "Sector 0 is an architecture and interior design studio in Bucharest creating residential spaces, renovations and custom furniture from concept to execution.",
  image = "/og.png",
  preloadImage,
  lang = "en",
  ogLocale = lang === "ro" ? "ro_RO" : "en_GB",
  alternateLanguages = [],
  schema,
} = Astro.props;

const site = "https://www.sector0studio.com";
const canonical = new URL(Astro.url.pathname, site).href;
const socialImage = new URL(image, site).href;
const studioSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site}/#studio`,
  name: "Sector 0 Studio",
  url: site,
  image: `${site}/og.png`,
  logo: `${site}/favicon.svg`,
  description: "Independent architecture and interior design studio in Bucharest, Romania.",
  email: "info@sector0studio.com",
  telephone: "+40 770 644 501",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bucharest",
    addressCountry: "RO",
  },
  areaServed: ["Bucharest", "Romania", "Europe"],
  sameAs: ["https://www.instagram.com/sector0studio/"],
  founder: {
    "@type": "Person",
    name: "Andi Dumitru",
    jobTitle: "Architect",
  },
  knowsAbout: [
    "Architecture",
    "Interior architecture",
    "Interior design",
    "Residential renovation",
    "Custom furniture",
    "Custom joinery",
  ],
};
const structuredData = schema ? [studioSchema, schema] : studioSchema;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sector 0 Studio" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e9e5dc" />
    <link rel="canonical" href={canonical} />
    {alternateLanguages.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={new URL(href, site).href} />)}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Sector 0 Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>document.documentElement.classList.remove("no-js"); document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      (() => {
        const elements = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          elements.forEach((element) => element.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -8%", threshold: 0.08 });
        elements.forEach((element) => observer.observe(element));
      })();
    </script>
  </body>
</html>
