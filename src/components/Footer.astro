---
import Icon from "./Icon.astro";
import { services } from "../data/services.js";
const { lang = "en" } = Astro.props;
const ro = lang === "ro";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__lead">
    <p class="eyebrow">{ro ? "Ai un proiect în minte?" : "Have a project in mind?"}</p>
    <a href="/contact" class="site-footer__cta">{ro ? "Să începem cu o discuție." : "Let’s break ground."}<Icon name="arrow-up-right" /></a>
  </div>
  <nav class="footer-services" aria-label={ro ? "Servicii în București" : "Services in Bucharest, in Romanian"}>
    {services.map((service) => <a href={`/${service.slug}/`} lang="ro" hreflang="ro">{service.label}</a>)}
  </nav>
  <div class="site-footer__grid">
    <div><p>Sector 0 Studio</p><p>Architecture + Interior Design</p><a href="/ro/servicii">Servicii în română</a></div>
    <div class="site-footer__contact"><a href="mailto:info@sector0studio.com">info@sector0studio.com</a><a href="tel:+40770644501">+40 770 644 501</a></div>
    <div class="site-footer__social"><a href="https://www.instagram.com/sector0_studio/" target="_blank" rel="noreferrer">Instagram</a></div>
    <div class="site-footer__meta"><p>Bucharest, Romania</p><p>© {year} Sector 0</p></div>
  </div>
</footer>

<style>
  .footer-services { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-bottom: 2rem; font-size: 1rem; line-height: 1.5; }
  .footer-services a { border-bottom: 1px solid rgba(255,255,255,0.4); padding-bottom: 0.25rem; }
  .footer-services a:hover { opacity: 0.7; }
</style>
