---
const { name, label } = Astro.props;
const aria = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg {...aria} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {name === "arrow-right" && <><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></>}
  {name === "arrow-left" && <><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></>}
  {name === "arrow-up-right" && <><path d="M7 17 17 7"/><path d="M7 7h10v10"/></>}
  {name === "arrow-down-right" && <><path d="m7 7 10 10"/><path d="M17 7v10H7"/></>}
  {name === "arrow-down" && <><path d="M12 5v14"/><path d="m6 13 6 6 6-6"/></>}
  {name === "menu" && <><path d="M4 8h16"/><path d="M4 16h16"/></>}
  {name === "close" && <><path d="m6 6 12 12"/><path d="m18 6-12 12"/></>}
  {name === "pause" && <><path d="M9 5v14"/><path d="M15 5v14"/></>}
  {name === "play" && <path d="m8 5 11 7-11 7Z"/>}
  {name === "check" && <path d="m5 12 4 4L19 6"/>}
</svg>
